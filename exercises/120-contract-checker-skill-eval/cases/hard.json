[
  {
    "id": "hard-aligned-terse",
    "description": "Start state; terse request, no verdict format in the prompt.",
    "prompt": "Quick sanity check on the issue enums before I push, please.",
    "shouldActivate": true,
    "askVerdict": false,
    "mutations": [],
    "checkerExit": 0,
    "expect": { "kind": "contract", "aligned": true, "drift": [] }
  },
  {
    "id": "hard-order-only",
    "description": "Web IssueSeverity values reordered only. Order is not part of the contract: aligned.",
    "prompt": "Someone reformatted apps/web/src/domain/entities/Issue.ts. Did that break the issue contract?",
    "shouldActivate": true,
    "askVerdict": false,
    "mutations": [
      {
        "file": "apps/web/src/domain/entities/Issue.ts",
        "find": "'BLOCKER' | 'CRITICAL' | 'MAJOR' | 'MINOR' | 'INFO'",
        "replace": "'INFO' | 'MINOR' | 'MAJOR' | 'CRITICAL' | 'BLOCKER'"
      }
    ],
    "checkerExit": 0,
    "expect": { "kind": "contract", "aligned": true, "drift": [] }
  },
  {
    "id": "hard-api-const-only",
    "description": "FALSE_POSITIVE removed from the ISSUE_STATUSES validation array only; the union type is intact.",
    "prompt": "Since this morning the API rejects status FALSE_POSITIVE on updates. Is that an enum drift?",
    "shouldActivate": true,
    "askVerdict": false,
    "mutations": [
      {
        "file": "apps/api/src/types.ts",
        "find": "['OPEN', 'CONFIRMED', 'RESOLVED', 'FALSE_POSITIVE']",
        "replace": "['OPEN', 'CONFIRMED', 'RESOLVED']"
      }
    ],
    "checkerExit": 1,
    "expect": {
      "kind": "contract",
      "aligned": false,
      "drift": [
        { "enum": "IssueStatus", "files": [["apps/api/src/types.ts"]], "values": ["FALSE_POSITIVE"] }
      ]
    }
  },
  {
    "id": "hard-two-enums",
    "description": "Two drifts in two files: API IssueType COMMENT renamed NOTE; web IssueSeverity INFO renamed TRIVIAL.",
    "prompt": "Is the issue model still consistent across the repo after yesterday's merges?",
    "shouldActivate": true,
    "askVerdict": false,
    "mutations": [
      {
        "file": "apps/api/src/types.ts",
        "find": "'QUALITY_GATE_VIOLATION' | 'COMMENT';",
        "replace": "'QUALITY_GATE_VIOLATION' | 'NOTE';"
      },
      {
        "file": "apps/api/src/types.ts",
        "find": "['VULNERABILITY', 'QUALITY_GATE_VIOLATION', 'COMMENT']",
        "replace": "['VULNERABILITY', 'QUALITY_GATE_VIOLATION', 'NOTE']"
      },
      { "file": "apps/web/src/domain/entities/Issue.ts", "find": "'INFO'", "replace": "'TRIVIAL'" }
    ],
    "checkerExit": 1,
    "expect": {
      "kind": "contract",
      "aligned": false,
      "drift": [
        { "enum": "IssueType", "files": [["apps/api/src/types.ts"]], "values": ["COMMENT", "NOTE"] },
        { "enum": "IssueSeverity", "files": [["apps/web/src/domain/entities/Issue.ts"]], "values": ["INFO", "TRIVIAL"] }
      ]
    }
  },
  {
    "id": "hard-unrelated-errors",
    "description": "Issue-API behaviour question (not enum drift): the skill must not activate.",
    "prompt": "What HTTP status and error code does POST /issues/{projectId} return when the project does not exist?",
    "shouldActivate": false,
    "askVerdict": false,
    "mutations": [],
    "checkerExit": 0,
    "expect": { "kind": "unrelated", "mustMention": ["404", "PROJECT_NOT_FOUND"] }
  }
]
